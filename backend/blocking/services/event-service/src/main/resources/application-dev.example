# Database Configuration
spring:
  datasource:
    username: <<Username>>
    password: <<Password>>
    driver-class-name: org.postgresql.Driver

  # Enable DevTools
  devtools:
    restart:
      enabled: true
      poll-interval: 2s
      quiet-period: 1s
    livereload:
      enabled: true
      port: 35729

# Port
server:
  port: 8083
  ssl:
    certificate: classpath:keys/localhost+2.pem
    certificate-private-key: classpath:keys/localhost+2-key.pem

application:
  services:
    user-service:
      # Base URL to fetch business data from User Service
      url: https://localhost:8080

  security:
    # CORS
    cors:
      allowed-origins: https://localhost:3000