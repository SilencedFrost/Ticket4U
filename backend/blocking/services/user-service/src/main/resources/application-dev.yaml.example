# Database Configuration
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/dbname
    username: dbname
    password: pw
    driver-class-name: org.postgresql.Driver

  # Enable DevTools
  devtools:
    restart:
      enabled: true
      poll-interval: 2s
      quiet-period: 1s
    livereload:
      enabled: true
      port: 35729

# OAuth2 Configuration
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: xxx
            client-secret: xxx
            scope: openid,profile,email

# Port
server:
  port: 8080
  ssl:
    certificate: classpath:keys/localhost+2.pem
    certificate-private-key: classpath:keys/localhost+2-key.pem

application:
  security:
    # JWT
    jwt:
      private-key-path: keys/ec-private.pem
      public-key-path: keys/ec-public.pem
      key-id: auth-key-es256
      issuer: ticket4u

# CORS
    cors:
      allowed-origins: https://localhost:3000