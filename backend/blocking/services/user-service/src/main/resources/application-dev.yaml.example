# Database Configuration
spring:
  datasource:
    url: ${DB_USER_URL:jdbc:postgresql://localhost:5432/dbname}
    username: ${DB_USERNAME:dbname}
    password: ${DB_PASSWORD:pw}
    driver-class-name: org.postgresql.Driver

# OAuth2 Configuration
  security:
    oauth2:
      client:
        registration:
          google:
            client-id:
            client-secret:
            scope: openid,profile,email

# Port
server:
  port: ${SERVER_PORT:8080}

application:
  security:
    # JWT
    jwt:
      private-key-path: keys/ec-private.pem
      public-key-path: keys/ec-public.pem
      key-id: auth-key-es256
      issuer: ticket4u

# CORS
    cors:
      allowed-origins: ${FRONTEND_URL:http://localhost:port}