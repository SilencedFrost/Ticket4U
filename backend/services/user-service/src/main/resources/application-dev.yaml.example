# Database Configuration
spring:
  datasource:
    password: YOUR_PASSWORD_HERE

  # Enable DevTools
  devtools:
    restart:
      enabled: true
      poll-interval: 2s
      quiet-period: 1s
    livereload:
      enabled: true
      port: 35729

application:
  security:
    # Cors
    cors:
      allowed-origins: https://localhost:3000

server:
  ssl:
    certificate: classpath:keys/localhost+2.pem
    certificate-private-key: classpath:keys/localhost+2-key.pem